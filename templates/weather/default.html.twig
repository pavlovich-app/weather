{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="weather-side">
            <div class="weather-gradient"></div>
            <div class="date-container">
                <h2 class="date-dayname">{{ "now"|date("l") }}</h2>
                <span class="date-day">{{ weather is defined and weather and weather.lastUpdate is defined and weather.lastUpdate ? weather.lastUpdate|date('d M Y') : '-' }}</span>
                <i class="location-icon" data-feather="map-pin"></i>
                <span class="location">{{ weather.city|default('-') }}, {{ weather.country|default('-') }}</span>
            </div>
            <div class="weather-container"><i class="weather-icon" data-feather="sun"></i>
                <h1 class="weather-temp">{{ weather.temperature|default('-') }}°C</h1>
                <h3 class="weather-desc">{{ weather.description|default('-') }}</h3>
            </div>
        </div>
        <div class="info-side">
            <div class="today-info-container">
                <div class="today-info">
                    <div class="precipitation"> <span class="title">Max Temperature</span><span class="value">{{ weather.temperatureMax|default('-') }} °C</span>
                        <div class="clear"></div>
                    </div>

                    <div class="precipitation"> <span class="title">Min Temperature</span><span class="value">{{ weather.temperatureMin|default('-') }} °C</span>
                        <div class="clear"></div>
                    </div>

                    <div class="precipitation"> <span class="title">PRESSURE</span><span class="value">{{ weather.pressure|default('-') }} mb</span>
                        <div class="clear"></div>
                    </div>
                    <div class="humidity"> <span class="title">HUMIDITY</span><span class="value">{{ weather.humidity|default('-') }} %</span>
                        <div class="clear"></div>
                    </div>
                    <div class="wind"> <span class="title">WIND</span><span class="value">{{ weather.windSpeed|default('-') }} km/h</span>
                        <div class="clear"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}