{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="info-side">
            <div class="today-info-container">
                <div class="today-info">
                    {% for city in cities %}
                        <a href="{{ city|lower }}" class="title">{{ city }}</a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}